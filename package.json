{
  "name": "starter",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo build",
    "clean": "turbo clean && rm -rf node_modules .turbo",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:migrate:drop": "turbo run db:migrate:drop --filter=@starter/db",
    "db:pull": "turbo run db:pull",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio",
    "dev": "turbo dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepublishOnly": "turbo prepublishOnly",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "typecheck": "turbo typecheck",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260427.1",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "oxlint-tsgolint": "^0.22.1",
    "turbo": "^2.9.6"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.13",
  "catalog": {
    "zod": "^4.3.6"
  },
  "catalogs": {
    "react": {
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "react": "^19.2.5",
      "react-dom": "^19.2.5"
    },
    "build": {
      "@types/bun": "^1.3.13",
      "@types/node": "^25.6.0",
      "@typescript/native-preview": "^7.0.0-dev.20260427.1",
      "@vitejs/plugin-react": "^6.0.1",
      "nitro": "^3.0.260415-beta",
      "vite": "^8.0.10"
    },
    "ui": {
      "better-themes": "^1.1.0",
      "lucide-react": "^1.11.0",
      "sonner": "^2.0.7"
    },
    "tanstack": {
      "@tanstack/devtools-vite": "^0.6.0",
      "@tanstack/react-devtools": "^0.10.2",
      "@tanstack/react-form": "^1.29.1",
      "@tanstack/react-query": "^5.100.5",
      "@tanstack/react-query-devtools": "^5.100.5",
      "@tanstack/react-router": "^1.168.25",
      "@tanstack/react-router-devtools": "^1.166.13",
      "@tanstack/react-router-ssr-query": "^1.166.12",
      "@tanstack/react-start": "^1.167.50",
      "@tanstack/router-plugin": "^1.167.28",
      "@tanstack/react-table": "^8.21.3"
    },
    "db": {
      "@types/pg": "^8.20.0",
      "drizzle-kit": "^0.31.10",
      "drizzle-orm": "^0.45.2",
      "pg": "^8.20.0"
    },
    "tailwind": {
      "@tailwindcss/postcss": "^4.2.4",
      "@tailwindcss/vite": "^4.2.4",
      "tailwind-merge": "^3.5.0",
      "tailwindcss": "^4.2.4"
    },
    "testing": {
      "@testing-library/dom": "^10.4.1",
      "@testing-library/react": "^16.3.2",
      "jsdom": "^29.1.0",
      "vitest": "^4.1.5"
    },
    "auth": {
      "@better-auth/stripe": "1.6.9",
      "better-auth": "1.6.9"
    },
    "stripe": {
      "stripe": "^22.1.0"
    },
    "logging": {
      "@axiomhq/pino": "^1.6.0",
      "pino": "^10.3.1",
      "pino-pretty": "^13.1.3"
    },
    "sentry": {
      "@sentry/bun": "^10.50.0",
      "@sentry/tanstackstart-react": "^10.50.0"
    },
    "otel": {
      "@opentelemetry/api": "^1.9.1",
      "@opentelemetry/exporter-trace-otlp-proto": "^0.215.0",
      "@opentelemetry/instrumentation-http": "^0.215.0",
      "@opentelemetry/resources": "^2.7.0",
      "@opentelemetry/sdk-node": "^0.215.0",
      "@opentelemetry/sdk-trace-base": "^2.7.0",
      "@opentelemetry/semantic-conventions": "^1.40.0"
    },
    "orpc": {
      "@orpc/client": "^1.14.0",
      "@orpc/contract": "^1.14.0",
      "@orpc/experimental-pino": "^1.14.0",
      "@orpc/openapi": "^1.14.0",
      "@orpc/otel": "^1.14.0",
      "@orpc/server": "^1.14.0",
      "@orpc/tanstack-query": "^1.14.0",
      "@orpc/zod": "^1.14.0"
    }
  }
}
