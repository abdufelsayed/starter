{
  "name": "@starter/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production vite build && tsdown --config tsdown.config.ts",
    "clean": "git clean -xdf .output node_modules dist .turbo .tanstack .tsbuildinfo",
    "dev": "vite dev --port 3000",
    "preview": "vite preview",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsgo --noEmit"
  },
