    "@opentelemetry/semantic-conventions": "catalog:otel",
    "@orpc/client": "catalog:orpc",
    "@orpc/server": "catalog:orpc",
    "@orpc/tanstack-query": "catalog:orpc",
    "@sentry/tanstackstart-react": "catalog:sentry",
    "@starter/api": "workspace:*",
