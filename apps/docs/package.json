{
  "name": "@starter/docs",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "bun --bun vite dev --port=4000",
    "build": "bun --bun vite build",
    "start": "node .output/server/index.mjs",
    "preview": "bun --bun vite preview",
    "typecheck": "${BUN_INSTALL:-$HOME/.bun}/bin/bun --bun fumadocs-mdx && tsgo --noEmit",
    "postinstall": "${BUN_INSTALL:-$HOME/.bun}/bin/bun --bun fumadocs-mdx",
    "clean": "git clean -xdf .output node_modules dist .turbo .tanstack .source .tsbuildinfo"
  },
  "dependencies": {
    "@tanstack/react-router": "catalog:tanstack",
    "@tanstack/react-start": "catalog:tanstack",
    "fumadocs-core": "16.8.8",
    "fumadocs-mdx": "15.0.0",
    "fumadocs-ui": "16.8.8",
    "lucide-react": "catalog:ui",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "tailwind-merge": "catalog:tailwind",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@starter/tsconfig": "workspace:*",
    "@tailwindcss/vite": "catalog:tailwind",
    "@tanstack/react-router-devtools": "catalog:tanstack",
    "@types/bun": "catalog:build",
    "@types/mdx": "^2.0.13",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@typescript/native-preview": "catalog:build",
    "@vitejs/plugin-react": "catalog:build",
    "nitro": "catalog:build",
    "srvx": "^0.11.15",
    "tailwindcss": "catalog:tailwind",
    "vite": "catalog:build"
  }
}
